{
 "defs": {
  "R": "sqrt(x**2 + y**2)",
  "phi": "atan2(y, x)",
  "u": "R - 1.0",
  "C": "cos(3*phi)",
  "S": "sin(3*phi)",
  "Gx": "(2*u + 0.2*C)*x/R + (3*0.2*u*S)*y/R**2",
  "Gy": "(2*u + 0.2*C)*y/R - (3*0.2*u*S)*x/R**2"
 },
 "objects": {
  "B": [
   "-2*z*x/R**2",
   "-2*z*y/R**2",
   "(2*u + 0.2*C)/R"
  ],
  "psi": "u**2 + z**2 + 0.2*u*C",
  "p": "0"
 },
 "params": {
  "epsilon": 0.2
 }
}
